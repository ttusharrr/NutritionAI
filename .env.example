# NutriAI Web Frontend - Environment Variables Configuration Template
# Rename this file to '.env' and fill in your values.

# The base URL of the running NutriAI Flask Backend API
VITE_API_URL=http://localhost:5000/api

# Google OAuth2 Client ID for Web Sign-in
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id-here.apps.googleusercontent.com
