# NutriAI Backend - Environment Variables Configuration Template
# Rename this file to '.env' in the backend directory and configure the variables.

# Flask Server Config
FLASK_ENV=development
PORT=5000

# MongoDB URI (Atlas Cloud Cluster or local MongoDB instance)
MONGO_URI=mongodb://localhost:27017/nutriai

# JWT Authentication Config
JWT_SECRET_KEY=your-super-secure-random-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Gmail SMTP Email Configuration (for OTP delivery)
SENDER_EMAIL=your-sender-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password-here

# Google OAuth2 Credentials for Web and Mobile Authentication
GOOGLE_CLIENT_ID=your-google-web-client-id-here.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id-here.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Frontend Application URL (for CORS and redirect allowances)
FRONTEND_URL=http://localhost:5173

# LLM API Config (NVIDIA NIM or OpenAI compatible endpoint key)
NVIDIA_API_KEY=your-nvidia-api-key-here
